# Ship data files alongside the Python package. Without this, `pip install`
# from sdist skips evals/, examples/, presets/ — the things that make the
# tool actually useful.
include README.md
include LICENSE
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include ARCHITECTURE.md
include INSTALL.md
include requirements.txt
include pyproject.toml
include Makefile

include evals/*.yaml evals/*.yml
include presets/*.json
include examples/**/*.md
include .streamlit/*.toml
recursive-include docs *.svg *.md
recursive-exclude * __pycache__
recursive-exclude * *.py[cod]
